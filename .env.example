# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# Minimum needed to smoke-test the stateless moderation endpoints:

# HMAC shared secret the smoke script signs requests with. Any value works
# locally as long as the same value is used to run the service and the script.
INTERNAL_REQUEST_HMAC_SECRET=local-dev-secret

# GPU / OpenAI-compatible moderation endpoint (the three the CI supplies as
# PROD_API_BASE_URL / PROD_API_KEY / PROD_MODEL_NAME).
API_BASE_URL=
API_KEY=
MODEL_NAME=

# Optional: HTTP port (defaults to 8080)
# PORT=8080
